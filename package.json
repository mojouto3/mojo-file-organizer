{
  "name": "mojo-file-organizer",
  "version": "3.26.2",
  "description": "A modern, elegant file organizer desktop app for Windows",
  "main": "main.js",
  "author": "mojomultimedia",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "lint": "eslint main.js preload.js renderer.js translations.js",
    "lint:fix": "eslint main.js preload.js renderer.js translations.js --fix",
    "build": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always",
    "build:portable": "electron-builder --win --x64 --config.win.target=portable",
    "release:portable": "electron-builder --win --x64 --config.win.target=portable --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^26.15.0",
    "eslint": "^10.7.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.7"
  },
  "build": {
    "appId": "com.mojomultimedia.mojo-file-organizer",
    "productName": "Mojo File Organizer",
    "publish": {
      "provider": "github",
      "owner": "mojouto3",
      "repo": "mojo-file-organizer"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Mojo-File-Organizer-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mojo File Organizer",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}
