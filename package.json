{
  "name": "mojo-file-organizer",
  "version": "4.0.0",
  "description": "A modern, elegant file organizer desktop app for Windows",
  "main": "main.js",
  "author": "mojomultimedia",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "lint": "eslint main.js preload.js",
    "lint:fix": "eslint main.js preload.js --fix",
    "build": "npm run build:renderer && electron-builder --win --x64",
    "release": "npm run build:renderer && electron-builder --win --x64 --publish always",
    "build:portable": "npm run build:renderer && electron-builder --win --x64 --config.win.target=portable",
    "release:portable": "npm run build:renderer && electron-builder --win --x64 --config.win.target=portable --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "lucide-react": "^1.28.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^42.3.2",
    "electron-builder": "^26.15.0",
    "eslint": "^10.7.0",
    "framer-motion": "^12.43.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.7"
  },
  "build": {
    "appId": "com.mojomultimedia.mojo-file-organizer",
    "productName": "Mojo File Organizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "mojouto3",
      "repo": "mojo-file-organizer"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Mojo-File-Organizer-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mojo File Organizer",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}
