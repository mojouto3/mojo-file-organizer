{
  "name": "mojo-file-organizer",
  "version": "3.15.0",
  "description": "A modern, elegant file organizer desktop app for Windows",
  "main": "main.js",
  "author": "mojomultimedia",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.mojomultimedia.mojo-file-organizer",
    "productName": "Mojo File Organizer",
    "publish": {
      "provider": "github",
      "owner": "mojouto3",
      "repo": "mojo-file-organizer"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mojo File Organizer",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}
